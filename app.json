{
  "configVersion": "v3",
  "app": {
    "appId": 27766,
    "appName": "LaTeX Interpreter",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.2"
    },
    "icon": "icon.png",
    "vender": "Mdep",
    "description": "An app to display complex math equations right on your wrist!"
  },
  "permissions": [
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/detail"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "LaTeX Interpreter"
    }
  },
  "defaultLanguage": "en-US"
}
